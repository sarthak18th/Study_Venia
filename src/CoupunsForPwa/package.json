{
  "name": "apply-coupun-pwa",
  "version": "1.0.0",
  "description": "Adds a pincode functionality to PDP",
  "main": "src/index.js",
  "files": [
    "dist",
    "intercept.js"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --extensions \".js,.jsx\" && cp -r src/**/*.css dist/components",
    "prepublishOnly": "npm run build",
    "babel-version": "babel --version"
  },
  "keywords": [
    "magento",
    "pwa-studio",
    "venia",
    "intercept",
    "Coupun"
  ],
  "author": "sarthak18th <sarthakbansal@18thdigitech.net>",
  "license": "ISC",
  "pwa-studio": {
    "targets": {
      "intercept": "intercept.js"
    }
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.0",
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0"
  }
}